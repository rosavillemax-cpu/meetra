generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  handle        String    @unique
  timezone      String    @default("Europe/Istanbul")
  createdAt     DateTime  @default(now())

  eventTypes        EventType[]
  availabilityRules AvailabilityRule[]
  bookingsAsHost    Booking[]
  accounts          Account[]
  sessions          Session[]
  calendarIntegrations CalendarIntegration[]
  teamMemberships   TeamMember[]
}

model CalendarIntegration {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // 'google' | 'outlook'
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  calendarId   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}



model AvailabilityRule {
  id           String    @id @default(cuid())
  userId       String
  weekday      Int
  startTime    String
  endTime      String
  isOverride   Boolean   @default(false)
  overrideDate DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    TeamMember[]
  eventTypes TeamEventType[]
}

model TeamMember {
  id       String @id @default(cuid())
  teamId   String
  userId   String
  role     String @default("member") // 'admin' | 'member'
  priority Int    @default(0)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamEventType {
  id          String @id @default(cuid())
  teamId      String
  eventTypeId String
  routingType String @default("round_robin") // 'round_robin' | 'collective'

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@unique([teamId, eventTypeId])
}

model Booking {
  id          String   @id @default(uuid())
  eventTypeId String
  hostId      String
  guestEmail  String
  guestName   String
  startAt     DateTime
  endAt       DateTime
  status      String   @default("confirmed")
  answers     Json?
  icalUid     String?
  cancelToken String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  confirmationSentAt DateTime?
  reminderSentAt    DateTime?
  googleEventId  String?
  outlookEventId String?

  eventType EventType @relation(fields: [eventTypeId], references: [id])
  host      User      @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([startAt])
  @@index([status])
  @@index([eventTypeId])
}

model EventType {
  id           String  @id @default(uuid())
  userId       String
  slug         String
  title        String
  description  String?
  durationMin  Int     @default(30)
  bufferBefore Int     @default(0)
  bufferAfter  Int     @default(0)
  color        String  @default("#000000")
  active       Boolean @default(true)
  teamId       String?
  isTeamEvent  Boolean @default(false)
  locationType   String @default("google-meet")
  customLocation String?

  user        User           @relation(fields: [userId], references: [id])
  bookings    Booking[]
  teamEventTypes TeamEventType[]

  @@unique([userId, slug])
}

