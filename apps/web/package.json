{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "rm -rf node_modules/.prisma && prisma generate --schema=./prisma/schema.prisma && next build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "next lint"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/prisma-adapter": "^2.11.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^6.19.3",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.0",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vitest/ui": "^3.2.0",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.3",
    "typescript": "5.9.2",
    "vitest": "^3.2.0"
  }
}
